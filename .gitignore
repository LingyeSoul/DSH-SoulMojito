node_modules/
lib/
# 例外：scripts/lib 是仓库脚本（v0 turn 修复引擎等），不是构建产物。
# 全局 lib/ 规则曾把它静默挡在 git 之外，导致 48f3f74 提交的脚本引用孤儿模块。
!scripts/lib/
dist/
*.tsbuildinfo
/.playwright-mcp
# packages/plugin 根的发布产物（index/agent/compaction/novel/card-workbench.mjs 与
# client/index.js）是有意入库的：仓库无 release/tag，git spec 安装与自更新 checkout
# 兜底都以分支头为发布通道，产物不入库即装完即坏。唯一例外 version.json——它带
# 本地 commit 戳、每次构建不同，不入库（等价常量已烤入 bundle）。
/packages/plugin/version.json
/.npm-cache
/.pnpm-store
/.zcode
# 工具元数据（taste/本地设置），不入库
/.commandcode
